{
  "name": "@bpstr/roadmap-runner",
  "version": "0.6.1",
  "description": "Run long Markdown implementation roadmaps through fresh CLI coding-agent sessions until completion.",
  "type": "module",
  "bin": {
    "roadmap-runner": "./bin/roadmap-runner.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "codex",
    "claude",
    "gemini",
    "grok",
    "kimi",
    "muse",
    "roadmap",
    "agent",
    "automation",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpstr/roadmap-runner.git"
  },
  "homepage": "https://github.com/bpstr/roadmap-runner#readme",
  "bugs": {
    "url": "https://github.com/bpstr/roadmap-runner/issues"
  },
  "license": "MIT",
  "files": [
    "bin",
    "lib",
    "prompt.md",
    "supervisor.md",
    "SUPERVISION.md",
    "README.md",
    "LICENSE",
    "examples",
    "docs/mcp-events.md",
    "docs/roadmap-writing-skill-plan.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
