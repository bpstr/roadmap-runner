{
  "name": "@bpstr/roadmap-runner",
  "version": "0.8.0",
  "description": "Run long Markdown implementation roadmaps through fresh CLI coding-agent sessions until completion.",
  "type": "module",
  "bin": {
    "roadmap-runner": "./bin/roadmap-runner.js"
  },
  "scripts": {
    "test": "node test/run-tests.js",
    "build": "tsc",
    "check:package": "node scripts/check-package.js",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "codex",
    "claude",
    "gemini",
    "grok",
    "kimi",
    "muse",
    "roadmap",
    "agent",
    "automation",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpstr/roadmap-runner.git"
  },
  "homepage": "https://github.com/bpstr/roadmap-runner#readme",
  "bugs": {
    "url": "https://github.com/bpstr/roadmap-runner/issues"
  },
  "license": "MIT",
  "files": [
    "bin",
    "lib",
    "prompt.md",
    "supervisor.md",
    "SUPERVISION.md",
    "README.md",
    "LICENSE",
    "examples",
    "docs/mcp-events.md",
    "docs/roadmap-writing-skill-plan.md",
    "dist",
    "src",
    "skills",
    "docs/agent-integration.md",
    "docs/agent-integration-evidence.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "smol-toml": "1.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "typescript": "5.9.3"
  }
}
